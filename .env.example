# Public base URL used for canonical links, Open Graph and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin panel credentials (required to sign in at /admin/login).
# Change ADMIN_PASSWORD before going live; ADMIN_SESSION_SECRET must be >= 16 random chars.
ADMIN_PASSWORD=blackrose-dev
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Database (Supabase). Leave both blank in local dev to persist menu + bookings in .data/.
# Server-only: do NOT prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
